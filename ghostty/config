# Ghostty config. See all options and defaults with: ghostty +show-config --default --docs

# If MonoLisa isn't installed, or lacks a character, Ghostty falls back to its
# built-in default font (JetBrains Mono, bundled with Ghostty) automatically
font-family = MonoLisa
font-size = 17
# No ligatures
font-feature = -liga, -calt, -dlig

maximize = true

# Left Option acts as Alt (for shell shortcuts); right Option still types special characters
macos-option-as-alt = left
# Send real Alt+arrow keys to the shell instead of Ghostty's default word-jump sequences
keybind = alt+left=unbind
keybind = alt+right=unbind

# Shift+Enter inserts a newline (e.g. in Claude Code) instead of submitting
keybind = shift+enter=text:\x1b\r

# Keep shell integration working when running sudo
shell-integration-features = sudo
