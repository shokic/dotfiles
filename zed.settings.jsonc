// Zed settings. Only values that differ from Zed's defaults are listed here.
// See every default with `zed: open default settings` in the command palette (cmd-shift-p).
// Docs: https://zed.dev/docs/configuring-zed
{
  // ── Fonts & theme ────────────────────────────────────────────────
  // Editor font; the terminal uses it too. The interface keeps Zed's default font.
  "cli_default_open_behavior": "new_window",
  "buffer_font_family": "MonoLisa",
  "buffer_font_size": 16,
  "icon_theme": "Base Charmed Icons",

  // ── Editor ───────────────────────────────────────────────────────
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "cursor_animation": { "enabled": true },
  "indent_guides": { "enabled": false },
  "diagnostics": { "inline": { "enabled": true } },
  "search": {
    "button": false,
    // Scroll so the current match is in the middle of the screen
    "center_on_match": true,
  },
  "file_finder": { "modal_max_width": "xlarge" },
  "diff_view_style": "unified",

  // ── Layout: all panels on the left, no tab bar ───────────────────
  "tab_bar": { "show": false },
  "title_bar": { "show_user_picture": false },
  "project_panel": {
    "dock": "left",
    "starts_open": false,
    // Show the project's files directly, without the root folder above them
    "hide_root": true,
    "indent_size": 10,
    "entry_spacing": "standard",
    "indent_guides": { "show": "never" },
  },
  "outline_panel": { "dock": "left" },
  "git_panel": {
    "dock": "left",
    "group_by": "staging",
    "tree_view": true,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },

  // ── Git ──────────────────────────────────────────────────────────
  // Show the blame for the current line in the status bar instead of next to the code
  "git": { "inline_blame": { "location": "status_bar" } },

  // ── Formatting ───────────────────────────────────────────────────
  "format_on_save": "on",
  // Use Prettier for every language, not just the ones Zed enables it for by default
  "prettier": { "allowed": true },
  "code_actions_on_format": { "source.fixAll.eslint": true },

  // ── Language servers ─────────────────────────────────────────────
  "lsp": {
    // TypeScript/JavaScript
    "vtsls": {
      "enable_lsp_tasks": true,
      "settings": {
        // Fix imports automatically when a file is moved or renamed
        "typescript": { "updateImportsOnFileMove": { "enabled": "always" } },
        "javascript": { "updateImportsOnFileMove": { "enabled": "always" } },
      },
    },
  },

  // ── AI ───────────────────────────────────────────────────────────
  // Turns off the agent panel, edit predictions and all other AI features
  "disable_ai": true,
}
